        },
        {
          "name": "Aceptar solicitud (PATCH /interactions/:id)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "proveedor.demo@nexobarrio.test" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accept\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/app/interactions/{{interactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "app", "interactions", "{{interactionId}}"]
            }
